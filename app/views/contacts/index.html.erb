<% content_for :title, "Contacts" %>

  <div class="d-flex justify-content-between align-items-center">
    <h1>Contacts</h1>

    <%= link_to "New contact" , new_contact_path, class:"btn btn-primary" %>
  </div>

  <% if @contacts.size == 0 %>

    <p class="container text-center"> There are no contacts yet. </p>

  <% else %>

  <div class="rounded-top overflow-hidden">
    <table class="table table-hover table-bordered">
      <thead class="header">
        <tr>
          <th> Name </th>
          <th> Age </th>
          <th> Email </th>
          <th> Actions </th>
        </tr>
      </thead>

      <tbody>
        <% @contacts.each do |contact| %>
          <tr>
            <% contact_name=contact.last_name + ", " + contact.first_name %>
              <td>
                <%= link_to contact_name, contact %>
              </td>
              <td>
                <%= contact.age%>
              </td>
              <td>
                <%= contact.email%>
              </td>
              <td>
                <%= link_to "Edit" , edit_contact_path(contact) %>
                  <%= link_to "Delete" , contact, data: {turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
              </td>
          </tr>
          <% end %>
      </tbody>
    </table>
  </div>

  <% end %>
